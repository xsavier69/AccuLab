---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import ExamCard from '../components/ExamCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { RUTAS } from '../data/rutas';
import { PAGINAS } from '../lib/catalogo';
import { waLink } from '../lib/site';

const r = RUTAS.domicilio;
const WA_DOM = 'Hola, necesito agendar una toma de muestras a domicilio. Mi sector es: ';
const COMUNES = ['biometria-hematica', 'glucosa', 'perfil-renal'].map((s) => PAGINAS.find((p) => p.slug === s)!);
const FAQS = [
  { p: '¿En qué sectores de Cuenca atienden a domicilio?', r: 'Consúltanos por WhatsApp la cobertura en tu sector; te confirmamos disponibilidad y horario.' },
  { p: '¿Cómo recibo los resultados?', r: 'Igual que en el laboratorio: por WhatsApp o por correo electrónico. La mayoría de exámenes está lista en 24 horas.' },
];
---
<Layout title={r.title} description={r.description} path={r.path} waMensaje={WA_DOM}
  crumbs={[{ name: 'Inicio', path: '/' }, { name: 'Servicios', path: '/servicios' }, { name: 'Domicilio', path: '/domicilio' }]}>
  <PageHero title="Exámenes de laboratorio a domicilio en Cuenca"
    lead="Tomamos tus muestras en casa para que no tengas que trasladarte. Agenda por WhatsApp y te confirmamos la cobertura en tu sector.">
    <div class="cluster mt-8">
      <a class="btn btn--whatsapp" href={waLink(WA_DOM)} target="_blank" rel="noopener"><Icon name="whatsapp" /> Agendar a domicilio</a>
      <a class="btn btn--secondary" href="/cotizar">Ver precios</a>
    </div>
  </PageHero>

  <section class="section section--tint" aria-labelledby="que-es">
    <div class="container grid grid--2" style="align-items:center">
      <div class="stack reveal">
        <h2 id="que-es">La toma de muestras, en la comodidad de tu hogar</h2>
        <p class="muted">Con la toma a domicilio, la muestra se recoge en tu casa y se procesa en nuestro laboratorio. Recibes los resultados por WhatsApp o correo, igual que si vinieras a Consultorios El Batán.</p>
        <p class="muted">Antes de la visita te indicamos la preparación que necesitas, por ejemplo, si debes estar en ayunas.</p>
      </div>
      <PhotoSlot ratio="4 / 3" id="domicilio" />
    </div>
  </section>

  <section class="section" aria-labelledby="para-quien">
    <div class="container">
      <div class="section-head"><h2 id="para-quien">Pensado para quienes más lo necesitan</h2></div>
      <div class="grid grid--3">
        <article class="card reveal"><span class="card__icon"><Icon name="users" /></span><h3>Adultos mayores</h3><p class="muted">Evita traslados y esperas para los controles frecuentes.</p></article>
        <article class="card reveal"><span class="card__icon"><Icon name="heart-pulse" /></span><h3>Pacientes post cirugía</h3><p class="muted">Controles de laboratorio durante la recuperación, sin salir de casa.</p></article>
        <article class="card reveal"><span class="card__icon"><Icon name="clock" /></span><h3>Personas ocupadas</h3><p class="muted">Para quienes tienen poca disponibilidad de tiempo.</p></article>
      </div>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="como-agendar">
    <div class="container">
      <div class="section-head"><h2 id="como-agendar">Agenda tu toma a domicilio por WhatsApp</h2></div>
      <ol class="steps">
        <li class="reveal"><h3>Escríbenos</h3><p class="muted">Envíanos por WhatsApp tu sector y los exámenes que necesitas (o una foto de tu orden).</p></li>
        <li class="reveal"><h3>Confirmamos</h3><p class="muted">Te confirmamos la cobertura en tu sector, el horario y la preparación.</p></li>
        <li class="reveal"><h3>Tomamos la muestra</h3><p class="muted">Recogemos la muestra en tu domicilio y te enviamos los resultados por WhatsApp o correo.</p></li>
      </ol>
      <div class="note mt-12" role="note"><Icon name="map-pin" size={18} /><p>Consúltanos por WhatsApp la cobertura en tu sector.</p></div>
    </div>
  </section>

  <section class="section" aria-labelledby="examenes-domicilio">
    <div class="container">
      <div class="section-head section-head--row">
        <div><h2 id="examenes-domicilio">Algunos exámenes frecuentes</h2><p class="muted">Confírmanos por WhatsApp si tu examen puede tomarse a domicilio.</p></div>
        <a class="link-arrow" href="/examenes">Ver todos los exámenes <Icon name="arrow-right" /></a>
      </div>
      <div class="grid grid--3">{COMUNES.map((p) => <ExamCard pagina={p} />)}</div>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="faq-dom">
    <div class="container container--narrow">
      <h2 id="faq-dom">Preguntas sobre el servicio a domicilio</h2>
      <div class="mt-8"><Faq items={FAQS} /></div>
    </div>
  </section>

  <CtaBand titulo="Agenda tu toma a domicilio" texto="Escríbenos tu sector y los exámenes que necesitas. Te confirmamos cobertura, horario y preparación." mensaje={WA_DOM} />
</Layout>
