---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import Ubicacion from '../components/Ubicacion.astro';
import { RUTAS } from '../data/rutas';
import { FAQ_PUBLICADA as FAQ } from '../data/faq';
import { faqSchema } from '../lib/schema';
import { waLink } from '../lib/site';

const r = RUTAS.faq;
const grupos = [...new Set(FAQ.map((f) => f.grupo))];
---
<Layout title={r.title} description={r.description} path={r.path} schemas={[faqSchema(FAQ)]}
  crumbs={[{ name: 'Inicio', path: '/' }, { name: 'Preguntas frecuentes', path: '/preguntas-frecuentes' }]}>
  <PageHero title="Preguntas frecuentes" lead="Todo lo que necesitas saber antes de venir a Accu-Lab: horarios, citas, resultados, ubicación y toma a domicilio." />

  <section class="section section--tint" style="padding-top:var(--s-12)">
    <div class="container container--narrow">
      {grupos.map((g, i) => (
        <div class={i > 0 ? 'mt-12' : ''}>
          <h2 class="faq-group">{g}</h2>
          <div class="mt-4"><Faq items={FAQ.filter((f) => f.grupo === g)} /></div>
        </div>
      ))}
      <div class="note mt-12" role="note">
        <Icon name="circle-help" size={18} />
        <p>¿Tienes otra pregunta? <a href={waLink('Hola, tengo una pregunta.')} target="_blank" rel="noopener">Escríbenos por WhatsApp</a> o llámanos al <a href="tel:+593996405647">099-640-5647</a>.</p>
      </div>
    </div>
  </section>

  <Ubicacion titulo="¿Dónde estamos?" />
</Layout>
<style>
  .faq-group { font-size: var(--fs-lg); }
  .note a { color: var(--primary); }
</style>
