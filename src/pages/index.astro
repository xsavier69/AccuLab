---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Pattern from '../components/Pattern.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import ExamCard from '../components/ExamCard.astro';
import PackageCard from '../components/PackageCard.astro';
import Faq from '../components/Faq.astro';
import Ubicacion from '../components/Ubicacion.astro';
import CtaBand from '../components/CtaBand.astro';
import Resenas from '../components/Resenas.astro';
import portada from '../assets/fotos/portada.webp';
import { RUTAS } from '../data/rutas';
import { EXAMENES, PAGINAS, PAQUETES } from '../lib/catalogo';
import { SITE, waLink, WA_GENERAL } from '../lib/site';
import { FAQ_CORTA } from '../data/faq';

const r = RUTAS.home;
const MAS_SOLICITADOS = ['biometria-hematica', 'glucosa', 'perfil-lipidico', 'examen-de-orina-emo', 'coproparasitario', 'perfil-tiroideo', 'prueba-de-embarazo-en-sangre', 'hemoglobina-glicosilada']
  .map((s) => PAGINAS.find((p) => p.slug === s)!);
const DESTACADOS = ['chequeo-preventivo-anual', 'hormonal-femenino', 'perfil-metabolico'].map((s) => PAQUETES.find((p) => p.slug === s)!);
---
<Layout title={r.title} description={r.description} path="/" catalogo>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <h1>Laboratorio clínico en Cuenca con resultados en <em>24 horas</em></h1>
        <p class="hero__sub serif">Tu salud merece atención precisa y oportuna.</p>
        <p class="lead">Consulta el precio de tu examen y agéndalo por WhatsApp.</p>
        <div class="cluster hero__cta">
          <a class="btn btn--whatsapp" href={waLink(WA_GENERAL)} target="_blank" rel="noopener"><Icon name="whatsapp" /> Agendar por WhatsApp</a>
          <a class="btn btn--secondary" href="/cotizar">Ver precios de exámenes <Icon name="arrow-right" /></a>
        </div>
        <ul class="hero__trust" role="list">
          <li><Icon name="check-circle" size={18} /> Sin cita previa</li>
          <li><Icon name="check-circle" size={18} /> Resultados por WhatsApp o correo</li>
          <li><Icon name="check-circle" size={18} /> Toma a domicilio</li>
        </ul>
      </div>
      <div class="hero__media">
        <Pattern variant="petri" class="hero__petri" />
        <PhotoSlot src={portada} alt="Procesamiento de muestras de sangre con micropipeta en un laboratorio clínico" ratio="4 / 5" priority
          widths={[400, 640, 900, 1200]} sizes="(min-width: 1024px) 480px, 92vw" id="home-hero" />
        <div class="hero__card">
          <Icon name="clock" size={20} />
          <div><strong>Horario</strong><br /><span class="small">{SITE.horarioCorto}</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- DATOS -->
  <section class="section section--tint" aria-label="Accu-Lab en cifras" style="padding-block:var(--s-16)">
    <div class="container">
      <div class="stats stats--3">
        <div class="stat reveal"><span class="stat__num">24<span>h</span></span><span class="stat__label">Resultados en la mayoría de exámenes</span></div>
        <div class="stat reveal"><span class="stat__num">{EXAMENES.length}</span><span class="stat__label">Exámenes con precio publicado</span></div>
        <div class="stat reveal"><span class="stat__num"><Icon name="house" size={44} class="stat__icon" /></span><span class="stat__label">Toma de muestras a domicilio</span></div>
      </div>
    </div>
  </section>

  <!-- MÁS SOLICITADOS -->
  <section class="section" aria-labelledby="solicitados">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <h2 id="solicitados">Exámenes más solicitados</h2>
        </div>
        <a class="link-arrow" href="/examenes">Ver todos los exámenes <Icon name="arrow-right" /></a>
      </div>
      <div class="grid grid--4">
        {MAS_SOLICITADOS.map((p) => <ExamCard pagina={p} />)}
      </div>
      <p class="small muted mt-6">Precios referenciales en dólares. Confírmalos con nosotros al agendar. <a href="/cotizar">Consulta la lista completa de precios de exámenes de laboratorio</a>.</p>
    </div>
  </section>

  <!-- PAQUETES -->
  <section class="section section--tint" aria-labelledby="paquetes-titulo">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <h2 id="paquetes-titulo">Paquetes de exámenes</h2>
          <p class="muted">Exámenes agrupados según lo que necesitas evaluar.</p>
        </div>
        <a class="link-arrow" href="/paquetes">Ver los 10 paquetes <Icon name="arrow-right" /></a>
      </div>
      <div class="grid grid--3">
        {DESTACADOS.map((pq) => <PackageCard paquete={pq} />)}
      </div>
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section class="section" aria-labelledby="como-funciona">
    <div class="container">
      <div class="section-head">
        <h2 id="como-funciona">Cómo funciona</h2>
      </div>
      <ol class="steps">
        <li class="reveal"><h3>Agenda o visítanos</h3><p class="muted">Escríbenos por WhatsApp o ven directamente a Consultorios El Batán. No necesitas cita.</p></li>
        <li class="reveal"><h3>Toma de muestra</h3><p class="muted">Te indicamos la preparación antes de venir y tomamos la muestra en el laboratorio o en tu domicilio.</p></li>
        <li class="reveal"><h3>Recibe tus resultados</h3><p class="muted">En la mayoría de exámenes, en 24 horas, por WhatsApp o correo electrónico.</p></li>
      </ol>
    </div>
  </section>

  <!-- PARA QUIÉN -->
  <section class="section section--ink" aria-labelledby="para-quien">
    <div class="container">
      <div class="section-head">
        <h2 id="para-quien">Atendemos a pacientes, empresas y médicos</h2>
      </div>
      <div class="grid grid--3">
        <a class="audience reveal" href="/examenes">
          <Icon name="user" size={28} />
          <h3>Pacientes</h3>
          <p>Exámenes de rutina, controles y chequeos preventivos con precios claros.</p>
          <span class="link-arrow">Ver exámenes <Icon name="arrow-right" /></span>
        </a>
        <a class="audience reveal" href="/empresas">
          <Icon name="building-2" size={28} />
          <h3>Empresas</h3>
          <p>Exámenes preocupacionales, ocupacionales periódicos y pruebas toxicológicas.</p>
          <span class="link-arrow">Exámenes para empresas <Icon name="arrow-right" /></span>
        </a>
        <a class="audience reveal" href="/medicos">
          <Icon name="stethoscope" size={28} />
          <h3>Médicos</h3>
          <p>Convenios con atención prioritaria para sus pacientes y comunicación directa.</p>
          <span class="link-arrow">Convenios médicos <Icon name="arrow-right" /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- DOMICILIO + PREPARACIÓN -->
  <section class="section" aria-label="Domicilio y preparación">
    <div class="container grid grid--2">
      <article class="card feature reveal">
        <span class="card__icon"><Icon name="car" /></span>
        <h2 class="feature__title">Tomamos tu muestra en casa</h2>
        <p class="muted">Ideal para adultos mayores, pacientes post cirugía o personas con poca disponibilidad de tiempo.</p>
        <div class="cluster card__foot">
          <a class="btn btn--whatsapp btn--sm" href={waLink('Hola, necesito agendar una toma de muestras a domicilio.')} target="_blank" rel="noopener"><Icon name="whatsapp" /> Agendar a domicilio</a>
          <a class="link-arrow" href="/domicilio">Exámenes a domicilio en Cuenca <Icon name="arrow-right" /></a>
        </div>
      </article>
      <article class="card feature reveal">
        <span class="card__icon"><Icon name="clipboard-list" /></span>
        <h2 class="feature__title">Prepárate bien</h2>
        <ul class="icon-list">
          <li><Icon name="utensils" /><span>Glucosa y perfil lipídico: ayuno de 8 a 12 horas (agua sí).</span></li>
          <li><Icon name="sun" /><span>EMO: primera orina de la mañana, chorro medio.</span></li>
          <li><Icon name="test-tube" /><span>Heces: muestra reciente en frasco limpio.</span></li>
        </ul>
        <div class="card__foot"><a class="link-arrow" href="/preparacion">Guía de preparación para exámenes <Icon name="arrow-right" /></a></div>
      </article>
    </div>
  </section>

  <Resenas />

  <Ubicacion />

  <!-- FAQ CORTA -->
  <section class="section section--tint" aria-labelledby="faq-home">
    <div class="container grid grid--2" style="align-items:start">
      <div class="section-head" style="margin:0">
        <h2 id="faq-home">Preguntas frecuentes</h2>
        <p class="muted">Lo que más nos preguntan antes de venir.</p>
        <a class="link-arrow" href="/preguntas-frecuentes">Ver todas las preguntas <Icon name="arrow-right" /></a>
      </div>
      <Faq items={FAQ_CORTA} />
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  .hero { position: relative; padding-block: var(--s-8) var(--s-16); overflow: hidden; }
  .hero__grid { display: grid; gap: var(--s-12); align-items: center; }
  .hero__text > * + * { margin-top: var(--s-5); }
  .hero__sub { font-size: clamp(var(--fs-md), 2.4vw, var(--fs-lg)); font-style: italic; color: var(--ink-2); line-height: 1.3; }
  .hero__cta { padding-top: var(--s-2); }
  .hero__trust { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); list-style: none; padding: 0; font-size: var(--fs-sm); color: var(--ink-2); }
  .hero__trust li { display: inline-flex; align-items: center; gap: 6px; }
  .hero__trust :global(svg) { color: var(--primary); }
  .hero__media { position: relative; max-width: 480px; width: 100%; margin-inline: auto; }
  .hero__media :global(.photo) { border-radius: 200px 200px var(--r-lg) var(--r-lg); box-shadow: var(--shadow-2); }
  .hero__media :global(.hero__petri) { position: absolute; width: 380px; right: -150px; top: -70px; color: var(--primary); opacity: 0.14; }
  .hero__card { position: absolute; left: -8px; bottom: 28px; display: flex; gap: 10px; align-items: center; background: var(--card); border: 1px solid var(--line); border-radius: var(--r); padding: 12px 16px; box-shadow: var(--shadow-2); font-size: var(--fs-sm); line-height: 1.35; }
  .hero__card :global(svg) { color: var(--primary); flex: none; }
  @media (min-width: 1024px) {
    .hero { padding-block: var(--s-16) var(--s-24); }
    .hero__grid { grid-template-columns: 1.15fr 0.85fr; gap: var(--s-16); }
    .hero__card { left: -40px; }
  }
  .stat__num :global(.stat__icon) { color: var(--primary); }
  .audience { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-8); border: 1px solid rgb(255 255 255 / 0.14); border-radius: var(--r-lg); text-decoration: none; color: #d9e2e4; transition: background-color 250ms var(--ease), border-color 250ms var(--ease); }
  .audience:hover { background: rgb(255 255 255 / 0.04); border-color: rgb(255 255 255 / 0.3); }
  .audience > :global(svg) { color: var(--leaf); margin-bottom: var(--s-2); }
  .audience .link-arrow { color: #fff; margin-top: auto; padding-top: var(--s-4); }
  .feature { gap: var(--s-3); padding: var(--s-8); }
  .feature .card__icon { margin-bottom: var(--s-2); }
  .feature__title { font-size: var(--fs-xl); }
  .feature .icon-list { margin-top: var(--s-3); }
</style>
