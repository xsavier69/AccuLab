---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Página no encontrada | Accu-Lab" description="La página que buscas no existe. Revisa nuestros exámenes, precios y paquetes o escríbenos por WhatsApp." path="/404" noindex>
  <PageHero title="No encontramos esta página" lead="Puede que el enlace haya cambiado. Estas secciones pueden ayudarte:">
    <div class="cluster mt-8">
      <a class="btn" href="/examenes">Exámenes</a>
      <a class="btn btn--secondary" href="/cotizar">Precios</a>
      <a class="btn btn--secondary" href="/">Inicio</a>
      <a class="btn btn--whatsapp" href="https://wa.me/593996405647" target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
    </div>
  </PageHero>
</Layout>
