---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { waLink } from '../lib/site';
---
<Layout title="Página no encontrada | Accu-Lab" description="La página que buscas no existe. Revisa nuestros exámenes, precios y paquetes o escríbenos por WhatsApp." path="/404" noindex>
  <PageHero title="No encontramos esta página" lead="Puede que el enlace haya cambiado. Estas secciones pueden ayudarte:">
    <div class="cluster mt-8">
      <a class="btn btn--whatsapp" href={waLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> Agendar por WhatsApp</a>
      <a class="link-arrow link-arrow--lg" href="/examenes">Exámenes</a>
      <a class="link-arrow link-arrow--lg" href="/cotizar">Precios</a>
      <a class="link-arrow link-arrow--lg" href="/">Inicio</a>
    </div>
  </PageHero>
</Layout>
